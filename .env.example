# Copy to .env. Real environment variables win over this file.
# One SWIS profile (same variables as swcheck):
SWIS_NETWORK=pilot
SWIS_URL=https://orion.example.local:17774
SWIS_USERNAME=DOMAIN\svc_swis_ro
SWIS_PASSWORD=
SWIS_VERIFY_TLS=false

# Sinks (defaults match deploy/docker-compose.dev.yml):
SWCOLLECT_PG_DSN=postgresql://swcollect:swcollect@127.0.0.1:15432/swcollect
SWCOLLECT_LOKI_URL=http://127.0.0.1:13100
SWCOLLECT_HOOK_TOKEN=
