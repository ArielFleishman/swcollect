          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (SELECT count(*) FROM sw_meta.raw_quarantine WHERE instance_id = $instance AND created_at > now() - interval '24 hours') + (SELECT count(*) FROM sw_meta.loki_rejected WHERE instance_id = $instance AND resolved_at IS NULL) AS \"Parked\""
