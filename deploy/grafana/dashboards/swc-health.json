          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'ok') AS \"ok\" FROM (SELECT DISTINCT ON (entity) entity, status, swis_count, received, stored, note, checked_at FROM sw_meta.coverage WHERE instance_id = $instance ORDER BY entity, checked_at DESC) c"
