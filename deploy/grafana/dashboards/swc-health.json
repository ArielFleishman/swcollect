          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT f.target_table AS \"Target\", f.rows_in AS \"In\", f.rows_out AS \"Out\", f.rows_dlq AS \"Dead letter\", CASE WHEN f.rows_in = f.rows_out + f.rows_dlq THEN 'balanced' ELSE 'NOT balanced' END AS \"Balance\" FROM sw_meta.flow f WHERE f.run_id = (SELECT max(r.run_id) FROM sw_meta.sync_run r WHERE r.instance_id = $instance AND r.job = 'curate' AND EXISTS (SELECT 1 FROM sw_meta.flow x WHERE x.run_id = r.run_id)) ORDER BY f.position"
