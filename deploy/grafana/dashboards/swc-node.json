    {
      "type": "table",
      "title": "Devices whose newest sample is old",
      "description": "SNMP devices with no CPU sample in the last 30 minutes of the server's clock: Orion stopped sampling (down, unmanaged) or the sample did not reach us. Not a zero load.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\" AS \"Device\", max(m.\"DateTime\") AS \"Newest CPU sample (as received)\", round(extract(epoch FROM ((now() AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance)) - max(m.\"DateTime\")) / 60) AS \"Minutes ago\" FROM sw_core.device d LEFT JOIN sw_ts.orion_cpuload m ON m.instance_id = d.instance_id AND m.\"NodeID\" = d.\"NodeID\" WHERE d.instance_id = $instance AND d.deleted_at IS NULL AND d.\"ObjectSubType\" = 'SNMP' GROUP BY 1 HAVING max(m.\"DateTime\") IS NULL OR max(m.\"DateTime\") < ((now() AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance)) - interval '30 minutes' ORDER BY 2 NULLS FIRST"
        }
      ],
      "fieldConfig": {
        "defaults": {
