    {
      "type": "table",
      "title": "Busiest CPUs",
      "description": "Top 10 by average AvgLoad over the dashboard time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.device_caption AS \"Device\", round(avg(m.\"AvgLoad\"), 1) AS \"Average CPU %\", max(m.\"MaxLoad\") AS \"Peak CPU %\", round(avg(m.\"AvgPercentMemoryUsed\")::numeric, 1) AS \"Average memory %\", count(*) AS \"Samples\" FROM sw_ts.v_orion_cpuload m WHERE m.instance_id = $instance AND m.\"DateTime\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"DateTime\" < ($__timeTo()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
