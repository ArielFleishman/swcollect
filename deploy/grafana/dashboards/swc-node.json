          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 85,
                "color": "rgba(208,59,59,0.12)"
              }
            ]
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
