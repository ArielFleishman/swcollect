{
  "uid": "swc-node",
  "title": "swcollect · Node performance",
  "description": "CPU, memory and response time from Orion.CPULoad and Orion.ResponseTime (sw_ts). Gaps are samples Orion did not take: a down, rebooting or unmanaged node. A missing sample is not zero. Times in tables are exactly as received from SolarWinds (server-local). Graphs place each point at the received time minus the server UTC offset measured by swcollect (sw_meta.instance.utc_offset_minutes).",
  "tags": [
    "swcollect",
    "metrics"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
