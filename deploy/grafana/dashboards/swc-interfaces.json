    {
      "type": "table",
      "title": "Busiest interfaces",
      "description": "Top 15 by peak utilization (SolarWinds' InPercentUtil / OutPercentUtil).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.device_caption AS \"Device\", m.interface_name AS \"Interface\", round(max(greatest(m.\"InPercentUtil\", m.\"OutPercentUtil\"))::numeric, 1) AS \"Peak %\", round(avg(m.\"InPercentUtil\")::numeric, 1) AS \"Average in %\", round(avg(m.\"OutPercentUtil\")::numeric, 1) AS \"Average out %\" FROM sw_ts.v_orion_npm_interfacetraffic m WHERE m.instance_id = $instance AND m.\"DateTime\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"DateTime\" < ($__timeTo()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
