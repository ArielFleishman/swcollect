          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (SELECT d.\"Caption\" FROM sw_core.device d WHERE d.instance_id = $instance AND d.\"NodeID\" = a.\"NodeID\" AND d.deleted_at IS NULL) AS \"Device\", p.\"UniqueName\" AS \"Poller\", (array_agg(m.\"Status\" ORDER BY m.\"DateTime\"))[1]::double precision AS \"First dBm\", (array_agg(m.\"Status\" ORDER BY m.\"DateTime\" DESC))[1]::double precision AS \"Last dBm\", round(((array_agg(m.\"Status\" ORDER BY m.\"DateTime\" DESC))[1]::numeric - (array_agg(m.\"Status\" ORDER BY m.\"DateTime\"))[1]::numeric), 2) AS \"Change dB\" FROM sw_ts.orion_npm_custompollerstatistics m JOIN sw_core.custom_poller_assignment a ON a.instance_id = m.instance_id AND a.\"CustomPollerAssignmentID\"::text = m.\"CustomPollerAssignmentID\"::text AND a.deleted_at IS NULL JOIN sw_core.custom_poller p ON p.instance_id = a.instance_id AND p.\"CustomPollerID\"::text = a.\"CustomPollerID\"::text AND p.deleted_at IS NULL WHERE m.instance_id = $instance AND m.\"DateTime\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"DateTime\" < ($__timeTo()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"Status\" ~ '^-?[0-9.]+$' GROUP BY 1, 2 ORDER BY 5 LIMIT 20"
        }
