          "uid": "swcollect-pg"
        },
        "query": "SELECT \"Caption\" AS __text, \"NodeID\" AS __value FROM sw_core.device WHERE instance_id = $instance AND deleted_at IS NULL ORDER BY 1",
        "definition": "SELECT \"Caption\" AS __text, \"NodeID\" AS __value FROM sw_core.device WHERE instance_id = $instance AND deleted_at IS NULL ORDER BY 1",
        "refresh": 1,
