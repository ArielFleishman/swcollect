    {
      "type": "timeseries",
      "title": "Optical power on the selected device (dBm)",
      "description": "CustomPollerStatistics.Status read as a number. Its unit is the poller's own (dBm for the Juniper DOM pollers, Orion.NPM.CustomPollers.Unit). Only devices with optical pollers have data.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT m.\"DateTime\" - (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AS time, p.\"UniqueName\" AS metric, m.\"Status\"::double precision AS value FROM sw_ts.orion_npm_custompollerstatistics m JOIN sw_core.custom_poller_assignment a ON a.instance_id = m.instance_id AND a.\"CustomPollerAssignmentID\"::text = m.\"CustomPollerAssignmentID\"::text AND a.deleted_at IS NULL JOIN sw_core.custom_poller p ON p.instance_id = a.instance_id AND p.\"CustomPollerID\"::text = a.\"CustomPollerID\"::text AND p.deleted_at IS NULL WHERE m.instance_id = $instance AND a.\"NodeID\" = $device AND m.\"DateTime\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"DateTime\" < ($__timeTo()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"Status\" ~ '^-?[0-9.]+$' ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "insertNulls": 1200000,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "jnxDomCurrentRxLaserPower"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "jnxDomCurrentTxLaserOutputPower"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
