    {
      "type": "table",
      "title": "Optical power change over the time range",
      "description": "First and last sample per poller in the range. A falling Rx level predicts a failing link (SPEC §2 optical transceivers).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
