{
  "uid": "swc-interfaces",
  "title": "swcollect · Interfaces",
  "description": "Traffic, utilization and errors from Orion.NPM.InterfaceTraffic / InterfaceErrors, and optical power from the custom pollers (Orion.NPM.CustomPollerStatistics). Times in tables are exactly as received from SolarWinds (server-local). Graphs place each point at the received time minus the server UTC offset measured by swcollect (sw_meta.instance.utc_offset_minutes).",
  "tags": [
    "swcollect",
    "metrics"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "annotations": {
    "list": []
