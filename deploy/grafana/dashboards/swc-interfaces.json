          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT m.device_caption AS \"Device\", m.interface_name AS \"Interface\", sum(m.\"InErrors\") AS \"In errors\", sum(m.\"CRCAlignErrors\") AS \"CRC errors\", sum(m.\"OutDiscards\") AS \"Out discards\" FROM sw_ts.v_orion_npm_interfaceerrors m WHERE m.instance_id = $instance AND m.\"DateTime\" >= ($__timeFrom()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) AND m.\"DateTime\" < ($__timeTo()::timestamptz AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance) GROUP BY 1, 2 HAVING sum(m.\"InErrors\") + sum(m.\"OutDiscards\") > 0 ORDER BY 4 DESC, 3 DESC LIMIT 15"
        }
