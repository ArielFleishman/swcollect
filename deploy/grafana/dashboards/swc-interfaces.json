          "type": "grafana-postgresql-datasource",
          "uid": "swcollect-pg"
        },
        "query": "SELECT i.\"Name\" AS __text, i.\"InterfaceID\" AS __value FROM sw_core.interface i WHERE i.instance_id = $instance AND i.\"NodeID\" = $device AND i.deleted_at IS NULL AND EXISTS (SELECT 1 FROM sw_ts.orion_npm_interfacetraffic t WHERE t.instance_id = i.instance_id AND t.\"InterfaceID\" = i.\"InterfaceID\") ORDER BY 1",
        "definition": "SELECT i.\"Name\" AS __text, i.\"InterfaceID\" AS __value FROM sw_core.interface i WHERE i.instance_id = $instance AND i.\"NodeID\" = $device AND i.deleted_at IS NULL AND EXISTS (SELECT 1 FROM sw_ts.orion_npm_interfacetraffic t WHERE t.instance_id = i.instance_id AND t.\"InterfaceID\" = i.\"InterfaceID\") ORDER BY 1",
