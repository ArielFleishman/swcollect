    {
      "type": "table",
      "title": "Hardware components",
      "description": "NCM.EntityPhysical through sw_core.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\" AS \"Device\", h.\"EntityClass\" AS \"Class\", h.\"EntityName\" AS \"Name\", h.\"Model\", h.\"Serial\", h.\"Manufacturer\", h.\"HardwareRevision\" AS \"HW rev\", h.\"SoftwareRevision\" AS \"SW rev\" FROM sw_core.hardware_component h JOIN sw_core.ncm_node nn ON nn.id = h.ncm_node_id LEFT JOIN sw_core.device d ON d.id = nn.device_id WHERE h.instance_id = $instance AND h.deleted_at IS NULL ORDER BY 1, h.\"EntPhysicalIndex\""
        }
      ],
