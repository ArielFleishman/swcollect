          "rawSql": "SELECT to_char(date_trunc('day', c.\"DownloadTime\"), 'YYYY-MM-DD') AS \"Day (server-local)\", count(*) AS \"Versions\" FROM sw_core.config_version c WHERE c.instance_id = $instance AND c.deleted_at IS NULL GROUP BY 1 ORDER BY 1"
