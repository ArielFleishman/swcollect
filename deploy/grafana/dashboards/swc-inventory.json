    {
      "type": "table",
      "title": "Compliance violations (Cirrus.PolicyCacheResults)",
      "description": "Rows with IsViolation = true, as NCM cached them. ErrorLevel is shown as its code (no published mapping).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\" AS \"Device\", p.\"ReportName\" AS \"Report\", p.\"RuleName\" AS \"Rule\", p.\"ErrorLevel\" AS \"Error level (code)\" FROM sw_raw.cirrus_policycacheresults p LEFT JOIN sw_core.ncm_node nn ON nn.instance_id = p.instance_id AND nn.\"NcmNodeID\" = p.\"NodeID\" LEFT JOIN sw_core.device d ON d.id = nn.device_id WHERE p.instance_id = $instance AND p._deleted_at IS NULL AND p.\"IsViolation\" ORDER BY 1, 3"
        }
      ],
