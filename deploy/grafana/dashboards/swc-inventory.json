    {
      "type": "table",
      "title": "Newest configuration backup per device",
      "description": "Age = the server's clock now minus DownloadTime (both server-local).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\" AS \"Device\", c.\"ConfigType\" AS \"Type\", max(c.\"DownloadTime\") AS \"Newest (as received)\", round(extract(epoch FROM ((now() AT TIME ZONE 'UTC') + (SELECT make_interval(mins => utc_offset_minutes) FROM sw_meta.instance WHERE instance_id = $instance)) - max(c.\"DownloadTime\")) / 3600) AS \"Age (hours)\", count(*) AS \"Versions\" FROM sw_core.config_version c JOIN sw_core.ncm_node nn ON nn.id = c.ncm_node_id LEFT JOIN sw_core.device d ON d.id = nn.device_id WHERE c.instance_id = $instance AND c.deleted_at IS NULL GROUP BY 1, 2 ORDER BY 4 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Age (hours)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "#0ca30c"
                    },
                    {
                      "value": 48,
                      "color": "#fab219"
                    },
                    {
                      "value": 168,
                      "color": "#d03b3b"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
