          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\" AS \"Device\", v.\"EntryId\" AS \"CVE\", a.\"Score\", a.\"Severity\", a.\"Summary\", v.\"State\" AS \"State (code)\" FROM sw_raw.ncm_vulnerabilitiesannouncementsnodes v JOIN sw_raw.ncm_vulnerabilitiesannouncements a ON a.instance_id = v.instance_id AND a.\"EntryId\" = v.\"EntryId\" AND a._deleted_at IS NULL LEFT JOIN sw_core.device d ON d.instance_id = v.instance_id AND d.\"NodeID\" = v.\"CoreNodeID\" AND d.deleted_at IS NULL WHERE v.instance_id = $instance AND v._deleted_at IS NULL ORDER BY a.\"Score\" DESC, 1"
