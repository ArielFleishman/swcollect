    {
      "type": "timeseries",
      "title": "Entries per interval, by kind",
      "description": "Loki entries per kind (label kind). Syslog and trap are told apart by Orion.OLM.LogEntryType.",
      "datasource": {
        "type": "loki",
        "uid": "swcollect-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "swcollect-loki"
          },
          "refId": "A",
          "expr": "sum by (kind) (count_over_time({job=\"swcollect\", instance=\"${instance:text}\"} [$__auto]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{kind}}"
        }
