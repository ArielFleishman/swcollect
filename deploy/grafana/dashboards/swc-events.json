        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "swcollect-pg"
        },
        "query": "SELECT instance_key AS __text, instance_id AS __value FROM sw_meta.instance ORDER BY 1",
        "definition": "SELECT instance_key AS __text, instance_id AS __value FROM sw_meta.instance ORDER BY 1",
        "refresh": 1,
