    {
      "type": "table",
      "title": "Active alerts",
      "description": "Orion.AlertActive with its alert object.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT a.\"TriggeredDateTime\" AS \"Triggered (as received)\", o.\"EntityCaption\" AS \"Object\", o.\"RelatedNodeCaption\" AS \"Node\", a.\"TriggeredMessage\" AS \"Message\", a.\"Acknowledged\", a.\"AcknowledgedBy\" AS \"By\" FROM sw_core.alert_active a LEFT JOIN sw_raw.orion_alertobjects o ON o.instance_id = a.instance_id AND o.\"AlertObjectID\" = a.\"AlertObjectID\" AND o._deleted_at IS NULL WHERE a.instance_id = $instance AND a.deleted_at IS NULL ORDER BY 1 DESC"
        }
