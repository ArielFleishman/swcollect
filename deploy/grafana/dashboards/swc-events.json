    {
      "type": "table",
      "title": "Alerts: push vs poll",
      "description": "matched = pushed by the Orion alert action and seen by the poll; poll_only = the push never arrived and the poll filled it; push_only = not (yet) in Orion.AlertHistory.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT status AS \"Status\", count(*) AS \"Alerts\", round(avg(extract(epoch FROM poll_at - push_at))::numeric, 1) AS \"Average push lead (s)\" FROM sw_meta.alert_reconcile WHERE instance_id = $instance GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
