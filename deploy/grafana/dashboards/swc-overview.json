          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(c.\"Role\", '(not set)') AS \"Role\", count(*) AS \"Devices\" FROM sw_core.device d LEFT JOIN sw_raw.orion_nodescustomproperties c ON c.instance_id = d.instance_id AND c.\"NodeID\" = d.\"NodeID\" AND c._deleted_at IS NULL WHERE d.instance_id = $instance AND d.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC"
