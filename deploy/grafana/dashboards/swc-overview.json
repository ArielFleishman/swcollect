    {
      "type": "stat",
      "title": "Not synced for over 60 min",
      "description": "Orion.Nodes.MinutesSinceLastSync > 60: data from this node is not being refreshed (stage A check #17). It does not say the node is down.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Stale\" FROM sw_raw.orion_nodes n WHERE n.instance_id = $instance AND n._deleted_at IS NULL AND n.\"MinutesSinceLastSync\" > 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#0ca30c"
              },
              {
                "value": 1,
                "color": "#d03b3b"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
