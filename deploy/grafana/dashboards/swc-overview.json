    {
      "type": "barchart",
      "title": "Devices by role (custom property)",
      "description": "Orion.NodesCustomProperties.Role, as set in Orion.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
