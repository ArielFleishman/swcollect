    {
      "type": "table",
      "title": "Devices",
      "description": "sw_core.device with the StatusDescription from the raw row. LastBoot / LastSync exactly as received. stable_id = <network>/<host:port>/<entity>/<key> (SPEC-B §6).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT d.\"Caption\", d.\"IPAddress\", d.\"Vendor\", d.\"MachineType\" AS \"Model\", d.\"SoftwareVersion\", d.\"Location\", n.\"StatusDescription\", d.\"MinutesSinceLastSync\", d.\"LastBoot\", d.\"LastSync\", d.stable_id FROM sw_core.device d LEFT JOIN sw_raw.orion_nodes n ON n.instance_id = d.instance_id AND n.\"NodeID\" = d.\"NodeID\" WHERE d.instance_id = $instance AND d.deleted_at IS NULL ORDER BY d.\"Caption\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "text"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MinutesSinceLastSync"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "transparent"
                    },
                    {
                      "value": 15,
                      "color": "#fab219"
                    },
                    {
                      "value": 60,
                      "color": "#d03b3b"
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
