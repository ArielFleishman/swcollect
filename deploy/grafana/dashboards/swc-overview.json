    {
      "type": "barchart",
      "title": "Devices by status (StatusDescription as received)",
      "description": "Orion.Nodes.StatusDescription: the label SolarWinds gives.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "swcollect-pg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "swcollect-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(n.\"StatusDescription\", '(null)') AS \"Status\", count(*) AS \"Devices\" FROM sw_raw.orion_nodes n WHERE n.instance_id = $instance AND n._deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
